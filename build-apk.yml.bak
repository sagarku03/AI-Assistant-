name: Build JARVIS APK

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]
  workflow_dispatch: # Allows manual trigger from GitHub UI

jobs:
  build:
    name: Compile & Generate APK
    runs-on: ubuntu-latest

    steps:
      - name: 📥 Checkout Code
        uses: actions/checkout@v4

      - name: ☕ Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: gradle

      - name: ⚙️ Grant execute permission for gradlew
        run: chmod +x gradlew

      - name: 🔨 Build Debug APK with Gradle
        run: ./gradlew assembleDebug --no-daemon --stacktrace

      - name: 📤 Upload APK Artifact (Direct Download)
        uses: actions/upload-artifact@v4
        with:
          name: JARVIS-AI-debug-apk
          path: app/build/outputs/apk/debug/app-debug.apk
          retention-days: 14

      - name: 🚀 Create GitHub Release with APK
        if: startsWith(github.ref, 'refs/tags/') || github.ref == 'refs/heads/main'
        uses: softprops/action-gh-release@v2
        with:
          files: app/build/outputs/apk/debug/app-debug.apk
          tag_name: v1.0.0-${{ github.run_number }}
          name: "JARVIS Mobile v1.0.0 (Build ${{ github.run_number }})"
          body: |
            ### 🤖 JARVIS Mobile AI Assistant APK
            - **Build Status**: Successful ✅
            - **Platform**: Android 8.0 - Android 14+
            - **Package**: `com.jarvis.ai`
            
            **Download the `app-debug.apk` file below and install on your phone!**
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
